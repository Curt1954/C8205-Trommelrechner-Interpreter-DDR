#DOK-0001 Summieren eines Vektors
#SPEI-0001 2020-2021
#PROT STUFE=2
0000: 00002002000 # 000 beginn ;
2000: 00002022000 # adr_a: da 000000002022 ; Adrese der ersten Komponente Vektor
2001: 00002025000 # adr_b: da 000000002025 ; Adresse der letzten Komponente Vektor
2002: 00002021241 # beginn: 241 zelle_s ; s:=0
2003: 00002000211 # 211 adr_a
2004: 00002020240 # schleife: 240 zelle_i ; i:=a
2005: 00000000251 # 251 0000
2006: 00002021210 # 210 zelle_s ; summe := summe + Speicher[i]
2007: 00002021240 # 240 zelle_s ; s:=summe
2010: 00002020211 # 211 zelle_i
2011: 00002017210 # 210 adr_1 ; i:=i+1
2012: 00002001330 # 330 adr_b
2013: 00002004140 # 140 schleife
2014: 00002021211 # 211 zelle_s ; AC:=Summe
2015: 00000001164 # halt: 164 0001 ; DEBUG Nr. 0001 aktivieren
2016: 00000000020 # 020 0 ; halt
2017: 00000001000 # adr_1: dw 0001000 ; eine Adreßeinheit
2022: 00000000144 # a: dw 100
2023: 00000000145 # dw 101
2024: 00000000310 # dw 200
2025: 00000000067 # b: dw 55
