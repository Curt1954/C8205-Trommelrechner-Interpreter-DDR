Trommeldatei:
#DOK-0001 BIS v6: Hauptprogramm alle-druck-up  Adressdruck, Befehlsdruck und Triadendruck nacheinander,
#DOK-001          Start mit Sofortbefehl 000 2000 von K0, Ausgabe auf SW
#SPEI-0001 0000-0000
#PROT STUFE=2
#TROMMEL=KEEP
--k0 datei=Test-virtuelleGeraete/T-SW-Eingabe/pj2-bis-minimalprogramm-alle-druck-up.txt
--sw-ausgabe Test-virtuelleGeraete/SW-Ausgabe/pj2-bis-minimalprogramm-alle-druck-up
0000: 00004500030 # haupt: 030 04500 ; Schreibwerk SW1 als Ausgabe anwaehlen
0001: 00001170030 # dz $inkb ; Zeichenlage Kleinbuchstaben (beim Start zufaellig)
0002: 00000017211 # 211 k_adr ; AC := Wort fuer den Adressdruck
0003: 00007773240 # 240 adr7773 ; Uebergabe in R1
0004: 00000220025 # 025 adressdruck ; Adressdruck
0005: 00002720030 # dz $wrzl ; Zeilenschaltung
0006: 00000020211 # 211 k_bef ; AC := Wort fuer den Befehlsdruck
0007: 00007773240 # 240 adr7773
0010: 00000240025 # 025 befehlsdruck ; Befehlsdruck
0011: 00002720030 # dz $wrzl
0012: 00000021211 # 211 k_tri ; AC := Wort fuer den Triadendruck
0013: 00007773240 # 240 adr7773
0014: 00000200025 # 025 triadendruck ; Triadendruck
0015: 00002720030 # dz $wrzl
0016: 00000000020 # 020 0 ; unbedingter Stopp
0017: 01234567012 # k_adr: dw 01234567012 ; Adressdruck: Ziffern 5 bis 8 = 4567
0020: 03210765432 # k_bef: dw 03210765432 ; Befehlsdruck: Ziffern 5 bis 11 = 0765 432
0021: 07654321065 # k_tri: dw 07654321065 ; Triadendruck: alle Ziffern = 0765 4321 065
