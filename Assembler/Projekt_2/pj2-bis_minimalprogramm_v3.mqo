               311            td_z           
               170            td_rs          
               004            zn             ; td_z := td_z um 1 Bit nach links
               spa            00114          
               dto            4              
verschieben:   006            speichern_r1   
               db             1              ; ungenutzt
konst_7:       dw             07             ; Konstante 0000 0000 007 zum Ausblenden
               db             2              ; ungenutzt
               spa            00122          
               dto            2              
               dto            7              
