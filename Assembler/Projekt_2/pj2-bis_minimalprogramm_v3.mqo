               000            schleife       ; naechste Ziffer
zn:            240            td_z           
               000            gruppe         ; Gruppenzaehler pruefen
               db             1              ; unbenutzt
               spa            00137          
               dto            3              
               equ            00200           
triadendruck:  240            td_rs          ; Rueckkehrbefehl sichern
               211            konst_1        
               440            adr7724        ; Einsen-Spur anlegen
