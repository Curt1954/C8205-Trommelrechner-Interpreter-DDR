             dw      010600000000         ; 46: o, kat4 106 << 24
             dw      012700000000         ; 47: p, kat4 127 << 24
             dw      013000000000         ; 50: q, kat4 130 << 24
             dw      011100000000         ; 51: r, kat4 111 << 24
             dw      011200000000         ; 52: WR, kat4 112 << 24
             spa     057                  ; unbelegte Eingabeadressen 53 bis 56 auslassen
             000     ML0021%              ; 57: Um. KB (Sprung-Umstellung)
             000     ML0022%              ; 60: ` / ; (Sprung-Umstellung)
             dw      014100000000         ; 61: / / ), kat4 141 << 24
