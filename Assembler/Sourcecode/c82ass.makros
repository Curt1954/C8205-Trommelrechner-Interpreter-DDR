             dw      004600000000         ; 26: f, kat4 046 << 24
             dw      006700000000         ; 27: g, kat4 067 << 24
             dw      007000000000         ; 30: h, kat4 070 << 24
             dw      005100000000         ; 31: i, kat4 051 << 24
             000     ML0014%              ; 32: SatzMarke / WRZL = Eingabeende
