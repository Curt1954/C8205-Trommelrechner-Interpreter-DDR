0000: 01 3010 211           211 d3010        ; <AC>:=a (Vorbereitung: AC muss laut Aufgabe schon a enthalten)
0001: 01 3000 000           000 m3000        ; Sprung zum Programmbeginn der Aufgabe in Zelle 3000
      20 0000 3000          equ 03000        
3000: 00 3006 644    m3000: 644 d3006        ; <AC>:=4a, <3006>:=a, <3023>:=2a
3001: 00 3006 214           214 d3006        ; <AC>:=2(4a+a)=10a
3002: 01 0001 164           164 00001        ; DEBUG Nr. 0001
3003: 01 0000 020           020 0            ; unbedingter Stop
      20 0000 3010          equ 03010        
3010: 00 77777777775 d3010: dw  077777777775 ; a = -3 (Zweierkomplement, 33 Bit)
