0000: 01 3100 000           000 m3100        ; Sprung zum Startstück
      20 0000 3100          equ 03100        
3100: 00 4500 030    m3100: 030 04500        ; Anwahl Kanal K2 (Schreibwerk-Ausgabe)
3101: 00 1170 030           030 01170        ; Umschaltung auf KB
3102: 01 3000 000           000 m3000        ; Sprung zum Programmanfang
      20 0000 7777          equ 07777        
7777: 00 70123456701 d7777: dw  070123456701 ; Zelle a = 7777, Testwert
      20 0000 3000          equ 03000        
3000: 00 4500 030    m3000: 030 04500        ; Programmanfang, Anwahl 2
3001: 01 3027 211           211 d3027        ; <AC>:=0000 0000 001
3002: 01 3032 000           000 m3032        ; Sprung nach 3032
3003: 01 7777 217    m3003: 217 d7777        ; <AC>:=Vzl2(a), 1. Teil
3004: 01 3015 006           006 m3015        ; <AC>:=Vzl2(a), 2. Teil
3005: 00 0010 030           030 00010        ; Druck "1"
3006: 00 0260 030           030 00260        ; Druck "6"
3007: 00 7721 520    m3007: 520 d7721        ; GX-Subtraktion zur Bestimmung der zu druckenden Oktalziffer
3010: 00 77740000000 d3010: dw  077740000000 ; Konstante
3011: 00 3020 311           311 d3020        ; <AC>:=z; Vergleicher 3, falls z=0
3012: 01 3036 170           170 m3036        ; Prüfen, ob z=0
3013: 01 3034 004           004 m3034        ; z:=Vl(z) (im Listing als "z:=z+1" gedruckt, Ablaufplan: z:=Vl(z))
3014: 00 0040 030           030 00040        ; Druck "4"
3015: 01 3024 006    m3015: 006 m3024        
      20 0000 3017          equ 03017        
3017: 00 00000000007 d3017: dw  07           ; Konstante zum Ausblenden der letzten Triade
      20 0000 3022          equ 03022        
3022: 00 0020 030           030 00020        ; Druck "2"
3023: 00 0070 030           030 00070        ; Druck "7"
3024: 01 7777 240    m3024: 240 d7777        ; a:=Vzl3(a)
3025: 01 3017 200           200 d3017        ; <AC>:=t
3026: 01 3007 000           000 m3007        
3027: 00 00000000001 d3027: dw  01           ; Konstante
3030: 00 0200 030           030 00200        ; Druck "0"
3031: 00 0250 030           030 00250        ; Druck "5"
3032: 00 7724 440    m3032: 440 d7724        
3033: 01 3010 211           211 d3010        ; <AC>:=7774 0000 000
3034: 00 3020 240    m3034: 240 d3020        ; <3020>:=z
3035: 01 3003 000           000 m3003        
