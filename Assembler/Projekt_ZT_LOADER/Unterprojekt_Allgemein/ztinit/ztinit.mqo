nach:           db              01              ; Laufzeit: Ausgabe auf ZT0 Spur 2 OHNE neue Anwahl
                020             0               ; Halt
ztinit:         240             ML0001DKR       ; Rueckkehrwort sichern
                211             ML0010DKR       ; AC := R1 (Adresse SPUF-00, Adressfeld)
                210             l0011           ; plus Operationscode 441 (Gruppenbefehl: alle 32 Zellen der Spur := 0)
                240             ML0002DKR       ; Befehl 441 <SPUF-00> auf die naechste Zelle
ML0002DKR:      db              1               ; Laufzeit: 441 <SPUF-00>, SPUF-00 := 0 (Nullpuffer), AC := 0
                241             ML0003DKR       ; g := 0 (laufende Spur 0 bis 511)
ML0004DKR:      211             ML0003DKR       ; AC := g
                200             l0012           ; nur d (Bit 7 und 8 von g, d * 0200)
                644             07670           ; 8 mal Linksverschiebung (Operand nach Festlegung 026)
                210             l0013           ; plus Anwahl ZT 0: 5d00 030
                240             ML0005DKR       ; Anwahlbefehl auf die naechste Zelle
ML0005DKR:      db              1               ; Laufzeit: 5d00 030, ZT d anwaehlen
                211             ML0003DKR       ; AC := g
                200             l0003           ; nur s (Bit 0 bis 6 von g)
                644             07656           ; 26 mal Linksverschiebung (Operand nach Festlegung 026)
