                210             l0004           ; plus 601, zzz0 = 0000: Spur 0
                240             ML0012DKR       ; Ausgabebefehl auf die naechste Zelle
ML0012DKR:      db              1               ; Laufzeit: 0000 bbbb 601, Spur 0 von ZT 0 schreiben (513. Ausgabe)
ML0001DKR:      db              1               ; Laufzeit: Rueckkehrsprung, hier am Ende des UP sequentiell erreicht
ML0003DKR:      db              1               ; Arbeitszelle g: laufende Spur 0 bis 511 (g = 128 * d + s)
zt_anw:         240             rueck_zt_anw    ; Rueckkehrwort sichern: Zusatztrommel zt_t anwaehlen (5d00 030, d = t = 0 bis 3)
