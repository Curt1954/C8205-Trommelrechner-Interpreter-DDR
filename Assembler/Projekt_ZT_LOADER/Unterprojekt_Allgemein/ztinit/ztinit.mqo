                210             l0004           ; plus Operationscode 601 (Ausgabe HT -> ZT)
                240             ML0006DKR       ; Ausgabebefehl auf die naechste Zelle
ML0006DKR:      db              1               ; Laufzeit: zzz0 bbbb 601, Nullpuffer auf Spur s der gewaehlten ZT
                211             ML0003DKR       ; AC := g
                210             l0014           ; plus 1
                240             ML0003DKR       ; g := g + 1
                330             l0015           ; Vergleich mit 512 (keine Operation)
