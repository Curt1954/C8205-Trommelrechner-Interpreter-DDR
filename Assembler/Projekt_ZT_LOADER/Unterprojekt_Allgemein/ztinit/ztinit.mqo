ML0008DKR:      db              1               ; Laufzeit: 240 <SPUF-00 Zelle 0>
                211             ML0010DKR       ; AC := R1
                210             l0018           ; plus 16 Adresseneinheiten (16 * 01000 = 020000) und 240: Zelle 16
                240             ML0009DKR       ; Speicherbefehl auf die naechste Zelle
                211             l0014           ; AC := 1 (Repository-Kopf)
ML0009DKR:      db              1               ; Laufzeit: 240 <SPUF-00 Zelle 16>
                211             ML0010DKR       ; AC := R1
                210             l0019           ; plus 19 Adresseneinheiten (023 * 01000) und 240: Zelle 19
