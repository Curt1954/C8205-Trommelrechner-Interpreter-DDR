                000             ML0004DKR       ; naechste Spur
ML0007DKR:      211             ML0010DKR       ; Spur 0 aufbauen: AC := R1
                210             l0016           ; plus Operationscode 240 (Speichern), Zelle 0 von SPUF-00
                240             ML0008DKR       ; Speicherbefehl auf die naechste Zelle
