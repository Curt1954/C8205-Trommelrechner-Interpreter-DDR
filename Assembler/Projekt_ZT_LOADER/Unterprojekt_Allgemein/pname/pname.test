Trommeldatei:
#ZTROMMEL=LEER
#DOK-0001 pname: Projektmakro PNAME (Element 13) mit 11a, drei Aufrufe (ID 3, 4 und 32), kat5-Name in einer Zelle, Eintrag zu 2 Zellen, Uebertrag Spur 127 -> Trommel 1 Spur 0, Wort 2 nur in den eigenen Feldern
#SPEI-0001 0001-0001
#PROT STUFE=2
#TROMMEL=LEER
0000: 00000006000 # 000 haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 00000240000 # apn: da 000000000240 ; Zelle 0001: Adresse SPUF-PN (Adressfeld)
