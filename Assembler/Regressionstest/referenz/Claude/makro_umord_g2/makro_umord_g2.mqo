kopf:          da             000000000110   ; Zelle 0002: Adresse der Marke am Aufruf von M2A (Wert der Marke mal 01000)
t1:            dw             0111           ; Programmrest, Zelle 1
t2:            dw             0222           ; Programmrest, Zelle 2
               dw             0701           ; erste Rumpfzelle (Marke fuer den Test)
