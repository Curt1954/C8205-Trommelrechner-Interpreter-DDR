kat5_sort2:                  000                          *+3                          ; Zelle 0000: Beginn des UP, Sprung ueber die zwei Parameter
p_adr:                       db                           1                            ; Parameter 1: Anfangsadresse des Feldes (vom Hauptprogramm gefuellt)
p_n:                         db                           1                            ; Parameter 2: Fuelllaenge, Anzahl der PAARE (vom Hauptprogramm gefuellt); ein Paar = 2 Zellen: kat5-Wort, Wert
                             240                          rueck                        ; erste Codezelle: Rueckkehrwort sichern
                             211                          p_n                          ; AC := n
                             330                          l0001                        ; AC mit 1 vergleichen
                             140                          rueck                        ; n <= 1: nichts zu sortieren, Rueckkehr
                             240                          zz                           ; zz := n (Zaehler)
                             211                          l0002                        ; AC := 0
                             240                          sn                           ; sn := 0 (n in Adresseneinheiten, 02000 je Paar)
cvt:                         211                          sn                           ; AC := sn
                             210                          l0003                        ; AC := sn + 02000 (ein Paar sind zwei Adresseinheiten)
                             240                          sn                           ; sn := AC
                             211                          zz                           ; AC := Zaehler
                             220                          l0001                        ; AC := Zaehler - 1
                             240                          zz                           ; zz := AC
                             330                          l0002                        ; AC mit 0 vergleichen
                             170                          sinit                        ; Zaehler = 0: sn fertig, AC = 0, weiter
                             000                          cvt                          ; sonst naechstes Paar
sinit:                       240                          si                           ; i := 0 (AC = 0), spaeter i := i + 1 (Paare)
                             210                          l0003                        ; AC := i + 1
skset:                       240                          sk                           ; k := i + 1
                             210                          p_adr                        ; AC := AC + Feldanfang
                             210                          l0004                        ; Befehl 240 a(k) bauen (kat5-Wort des Paares k)
                             240                          sb1                          ; sb1 := AC
                             251                          0                            ; AC := a(k)
                             240                          sh                           ; H := a(k)
                             211                          si                           ; AC := si
                             210                          p_adr                        ; AC := AC + Feldanfang
                             210                          l0004                        ; Befehl 240 a(i) bauen (kat5-Wort des Paares i)
                             240                          sb2                          ; sb2 := AC
                             251                          0                            ; AC := a(i)
                             330                          sh                           ; AC mit sh vergleichen
                             140                          sknext                       ; a(i) <= H: nicht tauschen
sb1:                         db                           01                           ; zur Laufzeit 240 a(k): a(k) := a(i)
                             211                          sh                           ; AC := alter Wert a(k)
sb2:                         db                           01                           ; zur Laufzeit 240 a(i): a(i) := alter Wert a(k)
                             211                          sk                           ; AC := sk (jetzt der Wert des Paares, eine Adresseinheit hinter dem kat5-Wort)
                             210                          p_adr                        ; AC := AC + Feldanfang
                             210                          l0005                        ; Befehl 240 w(k) bauen (01000 = eine Adresseinheit weiter, 0240 = Operationscode)
                             240                          sv1                          ; sv1 := AC
                             251                          0                            ; AC := w(k)
                             240                          sw                           ; sw := alter Wert w(k)
                             211                          si                           ; AC := si
                             210                          p_adr                        ; AC := AC + Feldanfang
                             210                          l0005                        ; Befehl 240 w(i) bauen
                             240                          sv2                          ; sv2 := AC
                             251                          0                            ; AC := w(i)
sv1:                         db                           01                           ; zur Laufzeit 240 w(k): w(k) := w(i)
                             211                          sw                           ; AC := alter Wert w(k)
sv2:                         db                           01                           ; zur Laufzeit 240 w(i): w(i) := alter Wert w(k)
sknext:                      211                          sk                           ; AC := sk
                             210                          l0003                        ; AC := k + 1 (ein Paar weiter)
                             330                          sn                           ; AC mit sn vergleichen
                             170                          sinext                       ; k + 1 = n: innere Schleife fertig
                             000                          skset                        ; weiter bei skset (AC = k + 1)
sinext:                      211                          si                           ; AC := si
                             210                          l0006                        ; AC := i + 2
                             330                          sn                           ; AC mit sn vergleichen
                             170                          rueck                        ; i + 2 = n: Rueckkehr
                             220                          l0003                        ; AC := i + 1
                             000                          sinit                        ; weiter bei sinit
rueck:                       db                           01                           ; Rueckkehrzelle: zur Laufzeit 000 <Rueckkehradresse> (Festlegung 010)
zz:                          db                           01                           ; Arbeitszelle zz: Zaehler der Umrechnung
sn:                          db                           01                           ; Arbeitszelle sn: n in Adresseneinheiten
si:                          db                           01                           ; Arbeitszelle si: Index i (Adresseneinheiten)
sk:                          db                           01                           ; Arbeitszelle sk: Index k (Adresseneinheiten)
sh:                          db                           01                           ; Arbeitszelle sh: Hilfswert H (kat5-Wort)
sw:                          db                           01                           ; Arbeitszelle sw: Hilfswert W (Wert)
haupt:                       211                          l0007                        ; AC := Adresse des Feldes
                             240                          kat5_sort2+1                 ; Parameter 1 eintragen (Zelle Marke+1)
                             211                          l0008                        ; AC := 20 (Anzahl der Paare)
                             240                          kat5_sort2+2                 ; Parameter 2 eintragen (Zelle Marke+2)
                             025                          kat5_sort2                   ; Aufruf des Unterprogramms
                             211                          l0009                        ; AC := Adresse der KB/GB-Zelle des Schreibwerks
                             240                          r3                           ; R3 := Adresse der Zustandszelle (Festlegung 030)
                             030                          04500                        ; 4500 oder K2 oder LSL2 oder SW1 Output
                             211                          l0010                        ; AC := Adresse des Wortes Zeilenschaltung + Um. KB
                             240                          r1                           ; R1 := Adresse von init
                             025                          ausgabe                      ; neue Zeile und Um. KB drucken (das BIS laesst das Schreibwerk auf GB)
                             211                          l0007                        ; AC := Adresse des (sortierten) Feldes
                             240                          pa                           ; pa := Adresse des ersten Textes
                             211                          l0008                        ; AC := 20 (Anzahl der Paare)
                             240                          pz                           ; pz := Zaehler der noch zu druckenden Texte
pl:                          211                          pa                           ; AC := Adresse des aktuellen Textes
                             240                          r1                           ; R1 := Adresse des Textes
                             025                          ausgabe                      ; Text drucken (KAT5AUSGABE)
                             211                          l0011                        ; AC := Adresse des Wortes Zeilenschaltung
                             240                          r1                           ; R1 := Adresse von zeil
                             025                          ausgabe                      ; Zeilenschaltung drucken
                             211                          pa                           ; AC := Adresse des aktuellen Textes
                             210                          l0003                        ; AC := Adresse des naechsten Textes (ein Paar = zwei Adresseinheiten weiter)
                             240                          pa                           ; pa := Adresse des naechsten Textes
                             211                          pz                           ; AC := Zaehler
                             220                          l0001                        ; AC := Zaehler - 1
                             240                          pz                           ; pz := AC
                             330                          l0002                        ; AC mit 0 vergleichen
                             170                          halt                         ; Zaehler = 0: alle Texte gedruckt, Halt
                             000                          pl                           ; sonst naechster Text
halt:                        020                          0                            ; Halt: Feld ist sortiert und gedruckt
feld:                        kat5                         uikxf                        ; Paar[0] kat5 = uikxf, Wort 04531335026
                             dw                           0451                         ; Paar[0] Wert = 0451
                             kat5                         hhi1h                        ; Paar[1] kat5 = hhi1h, Wort 03030311030
                             dw                           0502                         ; Paar[1] Wert = 0502
                             kat5                         1y                           ; Paar[2] kat5 = 1y, Wort 01051000000
                             dw                           0445                         ; Paar[2] Wert = 0445
                             kat5                         fu                           ; Paar[3] kat5 = fu, Wort 02645000000
                             dw                           0570                         ; Paar[3] Wert = 0570
                             kat5                         8pre                         ; Paar[4] kat5 = 8pre, Wort 01740422500
                             dw                           0702                         ; Paar[4] Wert = 0702
                             kat5                         w                            ; Paar[5] kat5 = w, Wort 04700000000
                             dw                           0552                         ; Paar[5] Wert = 0552
                             kat5                         lh17c                        ; Paar[6] kat5 = lh17c, Wort 03430101623
                             dw                           0550                         ; Paar[6] Wert = 0550
                             kat5                         d0n                          ; Paar[7] kat5 = d0n, Wort 02407360000
                             dw                           0644                         ; Paar[7] Wert = 0644
                             kat5                         r29pd                        ; Paar[8] kat5 = r29pd, Wort 04211204024
                             dw                           022                          ; Paar[8] Wert = 0022
                             kat5                         z                            ; Paar[9] kat5 = z, Wort 05200000000
                             dw                           0674                         ; Paar[9] Wert = 0674
                             kat5                         rns                          ; Paar[10] kat5 = rns, Wort 04236430000
                             dw                           0457                         ; Paar[10] Wert = 0457
                             kat5                         7                            ; Paar[11] kat5 = 7, Wort 01600000000
                             dw                           026                          ; Paar[11] Wert = 0026
                             kat5                         pzh                          ; Paar[12] kat5 = pzh, Wort 04052300000
                             dw                           0161                         ; Paar[12] Wert = 0161
                             kat5                         due                          ; Paar[13] kat5 = due, Wort 02445250000
                             dw                           0375                         ; Paar[13] Wert = 0375
                             kat5                         mk4z                         ; Paar[14] kat5 = mk4z, Wort 03533135200
                             dw                           0571                         ; Paar[14] Wert = 0571
                             kat5                         f4                           ; Paar[15] kat5 = f4, Wort 02613000000
                             dw                           0726                         ; Paar[15] Wert = 0726
                             kat5                         x0                           ; Paar[16] kat5 = x0, Wort 05007000000
                             dw                           0373                         ; Paar[16] Wert = 0373
                             kat5                         yv11f                        ; Paar[17] kat5 = yv11f, Wort 05146101026
                             dw                           0414                         ; Paar[17] Wert = 0414
                             kat5                         2x65                         ; Paar[18] kat5 = 2x65, Wort 01150151400
                             dw                           0723                         ; Paar[18] Wert = 0723
                             kat5                         ces                          ; Paar[19] kat5 = ces, Wort 02325430000
                             dw                           0337                         ; Paar[19] Wert = 0337
zeil:                        kat5                         $wrzl                        ; Wort Zeilenschaltung (kat5 053), steht hinter dem Feld
init:                        kat5                         $wrzl$inkb                   ; Wort Zeilenschaltung und Um. KB (kat5 053, 054): Anfang des Drucks
kbaus:                       dw                           0                            ; KB/GB-Zustand des Schreibwerks (0 = KB, 1 = GB), anfangs KB (Festlegung 030)
pa:                          db                           01                           ; Arbeitszelle pa: Adresse des aktuellen Textes beim Drucken
pz:                          db                           01                           ; Arbeitszelle pz: Zaehler beim Drucken
ausgabe:                     240                          ML0001GNU                    ; Rueckkehrwort sichern
                             211                          ML0014GNU                    ; AC := Adresse des Wortes (R1 bleibt unveraendert)
                             251                          0                            ; R-Lesebefehl: AC := Wort (Adresse im AC)
                             240                          ML0004GNU                    ; rest := Wort (nie negativ, z0 bis z2 sind 0)
ML0007GNU:                   330                          l0002                        ; Vergleich des Rests mit 0 (keine Operation), der AC bleibt der Rest
                             170                          ML0001GNU                    ; Rest 0: Wort fertig, Rueckkehr
                             642                          07675                        ; 15 mal Rechtsverschiebung (Operand nach Festlegung 026)
                             200                          l0012                        ; nur das Zeichen behalten
                             240                          ML0005GNU                    ; zeichen := Code mal 01000
                             330                          l0013                        ; Vergleich mit kat5 054 (Um. KB)
                             170                          ML0011GNU                    ; Um. KB: Zustand := KB
                             330                          l0014                        ; Vergleich mit kat5 055 (Um. GB)
                             170                          ML0011GNU                    ; Um. GB: Zustand := GB
ML0008GNU:                   210                          l0015                        ; plus Adresse der Tabelle, Code 01 steht auf ML0013%
                             251                          0                            ; R-Lesebefehl: AC := fertiger Ausgabebefehl des Zeichens
                             240                          ML0009GNU                    ; Ausgabebefehl auf die naechste Zelle speichern
ML0009GNU:                   db                           1                            ; Laufzeit: Ausgabebefehl, wird sofort ausgefuehrt
                             211                          ML0004GNU                    ; AC := Zeichenrest
                             200                          l0016                        ; erstes Zeichen entfernen (die unteren 24 Bit bleiben)
                             644                          07662                        ; 6 mal Linksverschiebung (Operand nach Festlegung 026)
                             240                          ML0004GNU                    ; rest := Rest
                             000                          ML0007GNU                    ; naechstes Zeichen (der AC ist der Rest)
ML0001GNU:                   db                           1                            ; Laufzeit: Rueckkehrsprung, hier am Ende des UP sequentiell erreicht
ML0011GNU:                   211                          ML0015GNU                    ; Um. KB / Um. GB: AC := R3 = Adresse der Zustandszelle (Adressfeld)
                             210                          l0004                        ; plus Operationscode 240: Speicherbefehl
                             240                          ML0012GNU                    ; Speicherbefehl auf die uebernaechste Zelle
                             211                          ML0005GNU                    ; AC := Code mal 01000 (054000 oder 055000)
                             220                          l0013                        ; AC := 0 (Um. KB) oder 01000 (Um. GB)
                             642                          07653                        ; 9 mal Rechtsverschiebung (Operand nach Festlegung 026)
ML0012GNU:                   db                           1                            ; Laufzeit: 240 <Zustandszelle>, speichert den Zustand
                             211                          ML0005GNU                    ; AC := Code mal 01000, zurueck zur Ausgabe des Zeichens
                             000                          ML0008GNU                    ; Zeichen ausgeben
ML0004GNU:                   db                           1                            ; Arbeitszelle: noch auszugebender Zeichenrest
ML0005GNU:                   db                           1                            ; Arbeitszelle: aktueller kat5-Code mal 01000
ML0013GNU:                   dto                          \ \                          ; Tabelle, Code 01: Leerzeichen
                             dz                           ,                            ; Code 02: Komma
                             dz                           -                            ; Code 03: Minus
                             dz                           .                            ; Code 04: Punkt
                             dz                           +                            ; Code 05: + und =
                             dz                           :                            ; Code 06: Doppelpunkt
