0000: 01 0021 000           000  haupt              ; Zelle 0000: Sprung zum Hauptprogramm
      00 14643432130 t1:    kat6 hallo welt         ; Zellen 0001 und 0002: Beispiel der Doku, Leerzeichen im Text ohne Backslash
      00 56343256612 ;    
      00 40000010001 t2:    kat6 10                 ; Zelle 0003: Ziffer 0 hat den Code 00, das Stoppbit steht darueber
