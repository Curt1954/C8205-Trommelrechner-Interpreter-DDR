      00 10157203767 t4:    kat6 x$ingb=$inkb1$wrzl ; Zellen 0005 und 0006: alle drei Marken, volles erstes Wort
      00 40000000132 ;    
      00 40001226121 t5:    kat6 a/b                ; Zelle 0007: / hat den Code 061
      00 52524232221 t6:    kat6 abcde              ; Zelle 0010: genau ein volles Wort, Stoppbit in z2
      00 54033607473 t7:    kat6 ,%`.-              ; Zelle 0011: , % Akzent . - (Codes 073 074 060 033 040)
      00 51110202015 t8:    kat6 :+=89              ; Zelle 0012: : + = 8 9 (+ und = haben denselben Code 020)
      00 40000000171 t9:    kat6 z                  ; Zelle 0013: ein einziges Zeichen
      00 12524232221 t10:   kat6 abcdef             ; Zellen 0014 und 0015: ein Zeichen im zweiten Wort
      00 40000000126 ;    
      00 40001122112 t11:   kat6 \ a \              ; Zelle 0016: drei Zeichen, fuehrendes und abschliessendes Leerzeichen bleiben
