0013: 00000000010 # dw 8 ; Symbol steht erst hinter end
0014: 00000000040 # dw 32 ; equ-Symbole, spur verweist auf lage: 040 = 32
0015: 00000007700 # dw 07700 ; 07640+040 = 07700
0016: 00000000020 # haupt: 020 0 ; Zelle 0016: Halt
