                             240                          ML0004JQX                    ; rest := Rest
                             000                          ML0007JQX                    ; naechstes Zeichen (der AC ist der Rest)
ML0001JQX:                   db                           1                            ; Laufzeit: Rueckkehrsprung, hier am Ende des UP sequentiell erreicht
