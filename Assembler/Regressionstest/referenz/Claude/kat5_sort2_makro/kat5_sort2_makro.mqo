sort2:                       000                          *+3                          ; Zelle 0 des UP: Sprung ueber die zwei Parameter
ML0017DKR:                   db                           1                            ; Parameter 1: Anfangsadresse des Feldes (vom Aufrufer gefuellt)
ML0018DKR:                   db                           1                            ; Parameter 2: Fuelllaenge, Anzahl der PAARE (vom Aufrufer gefuellt); ein Paar = 2 Zellen: kat5-Wort, Wert
                             240                          ML0001DKR                    ; erste Codezelle: Rueckkehrwort sichern
                             211                          ML0018DKR                    ; AC := n
                             330                          l0001                        ; AC mit 1 vergleichen
                             140                          ML0001DKR                    ; n <= 1: nichts zu sortieren, Rueckkehr
                             240                          ML0002DKR                    ; zz := n (Zaehler)
                             211                          l0002                        ; AC := 0
                             240                          ML0003DKR                    ; sn := 0 (n in Adresseneinheiten, 02000 je Paar)
ML0008DKR:                   211                          ML0003DKR                    ; AC := sn
                             210                          l0003                        ; AC := sn + 02000 (ein Paar sind zwei Adresseinheiten)
                             240                          ML0003DKR                    ; sn := AC
                             211                          ML0002DKR                    ; AC := Zaehler
                             220                          l0001                        ; AC := Zaehler - 1
                             240                          ML0002DKR                    ; zz := AC
                             330                          l0002                        ; AC mit 0 vergleichen
                             170                          ML0009DKR                    ; Zaehler = 0: sn fertig, AC = 0, weiter
                             000                          ML0008DKR                    ; sonst naechstes Paar
ML0009DKR:                   240                          ML0004DKR                    ; i := 0 (AC = 0), spaeter i := i + 1 (Paare)
                             210                          l0003                        ; AC := i + 1
ML0010DKR:                   240                          ML0005DKR                    ; k := i + 1
                             210                          ML0017DKR                    ; AC := AC + Feldanfang
                             210                          l0004                        ; Befehl 240 a(k) bauen (kat5-Wort des Paares k)
                             240                          ML0013DKR                    ; Befehlszelle 1 := AC
                             251                          0                            ; AC := a(k)
                             240                          ML0006DKR                    ; H := a(k)
                             211                          ML0004DKR                    ; AC := i
                             210                          ML0017DKR                    ; AC := AC + Feldanfang
                             210                          l0004                        ; Befehl 240 a(i) bauen (kat5-Wort des Paares i)
                             240                          ML0014DKR                    ; Befehlszelle 2 := AC
                             251                          0                            ; AC := a(i)
                             330                          ML0006DKR                    ; AC mit H vergleichen
                             140                          ML0011DKR                    ; a(i) <= H: nicht tauschen
ML0013DKR:                   db                           1                            ; Laufzeit: 240 a(k): a(k) := a(i)
                             211                          ML0006DKR                    ; AC := alter Wert a(k)
ML0014DKR:                   db                           1                            ; Laufzeit: 240 a(i): a(i) := alter Wert a(k)
                             211                          ML0005DKR                    ; AC := k (jetzt der Wert des Paares, eine Adresseinheit hinter dem kat5-Wort)
                             210                          ML0017DKR                    ; AC := AC + Feldanfang
                             210                          l0005                        ; Befehl 240 w(k) bauen (01000 = eine Adresseinheit weiter, 0240 = Operationscode)
                             240                          ML0015DKR                    ; Befehlszelle 3 := AC
                             251                          0                            ; AC := w(k)
                             240                          ML0007DKR                    ; W := alter Wert w(k)
                             211                          ML0004DKR                    ; AC := i
                             210                          ML0017DKR                    ; AC := AC + Feldanfang
                             210                          l0005                        ; Befehl 240 w(i) bauen
                             240                          ML0016DKR                    ; Befehlszelle 4 := AC
                             251                          0                            ; AC := w(i)
ML0015DKR:                   db                           1                            ; Laufzeit: 240 w(k): w(k) := w(i)
                             211                          ML0007DKR                    ; AC := alter Wert w(k)
ML0016DKR:                   db                           1                            ; Laufzeit: 240 w(i): w(i) := alter Wert w(k)
ML0011DKR:                   211                          ML0005DKR                    ; AC := k
                             210                          l0003                        ; AC := k + 1 (ein Paar weiter)
                             330                          ML0003DKR                    ; AC mit sn vergleichen
                             170                          ML0012DKR                    ; k + 1 = n: innere Schleife fertig
                             000                          ML0010DKR                    ; weiter (AC = k + 1)
ML0012DKR:                   211                          ML0004DKR                    ; AC := i
                             210                          l0006                        ; AC := i + 2
                             330                          ML0003DKR                    ; AC mit sn vergleichen
                             170                          ML0001DKR                    ; i + 2 = n: Rueckkehr
                             220                          l0003                        ; AC := i + 1
                             000                          ML0009DKR                    ; weiter bei i := i + 1
ML0001DKR:                   db                           1                            ; Laufzeit: Rueckkehrsprung (Festlegung 010), hier am Ende des UP sequentiell erreicht
ML0002DKR:                   db                           1                            ; Arbeitszelle: Zaehler der Umrechnung
ML0003DKR:                   db                           1                            ; Arbeitszelle: n in Adresseneinheiten
ML0004DKR:                   db                           1                            ; Arbeitszelle: Index i (Adresseneinheiten)
ML0005DKR:                   db                           1                            ; Arbeitszelle: Index k (Adresseneinheiten)
ML0006DKR:                   db                           1                            ; Arbeitszelle: Hilfswert H (kat5-Wort)
ML0007DKR:                   db                           1                            ; Arbeitszelle: Hilfswert W (Wert)
haupt:                       211                          l0007                        ; AC := Adresse des Feldes
                             240                          sort2+1                      ; Parameter 1 eintragen (Zelle Marke+1)
                             211                          l0008                        ; AC := 20 (Anzahl der Paare)
                             240                          sort2+2                      ; Parameter 2 eintragen (Zelle Marke+2)
                             025                          sort2                        ; Aufruf des Unterprogramms
                             211                          l0009                        ; AC := Adresse der KB/GB-Zelle des Schreibwerks
                             240                          r3                           ; R3 := Adresse der Zustandszelle (Festlegung 030)
                             030                          04500                        ; 4500 oder K2 oder LSL2 oder SW1 Output
                             211                          l0010                        ; AC := Adresse des Wortes Zeilenschaltung + Um. KB
                             240                          r1                           ; R1 := Adresse von init
                             025                          ausgabe                      ; neue Zeile und Um. KB drucken (das BIS laesst das Schreibwerk auf GB)
                             211                          l0007                        ; AC := Adresse des (sortierten) Feldes
                             240                          pa                           ; pa := Adresse des ersten Textes
                             211                          l0008                        ; AC := 20 (Anzahl der Paare)
                             240                          pz                           ; pz := Zaehler der noch zu druckenden Texte
pl:                          211                          pa                           ; AC := Adresse des aktuellen Textes
                             240                          r1                           ; R1 := Adresse des Textes
                             025                          ausgabe                      ; Text drucken (KAT5AUSGABE)
                             211                          l0011                        ; AC := Adresse des Wortes Zeilenschaltung
                             240                          r1                           ; R1 := Adresse von zeil
                             025                          ausgabe                      ; Zeilenschaltung drucken
                             211                          pa                           ; AC := Adresse des aktuellen Textes
                             210                          l0003                        ; AC := Adresse des naechsten Textes (ein Paar = zwei Adresseinheiten weiter)
                             240                          pa                           ; pa := Adresse des naechsten Textes
                             211                          pz                           ; AC := Zaehler
                             220                          l0001                        ; AC := Zaehler - 1
                             240                          pz                           ; pz := AC
                             330                          l0002                        ; AC mit 0 vergleichen
                             170                          halt                         ; Zaehler = 0: alle Texte gedruckt, Halt
                             000                          pl                           ; sonst naechster Text
halt:                        020                          0                            ; Halt: Feld ist sortiert und gedruckt
