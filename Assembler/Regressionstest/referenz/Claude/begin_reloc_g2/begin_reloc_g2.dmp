0000: 01 0002 000          000 haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 0              erg:  dw  0     ; Zelle 0001: Ergebnis
0002: 01 7543 211    haupt 211 l0001 ; Zelle 0002: AC := 9 (Literal)
0003: 01 7540 210          210 x1    ; Zelle 0003: AC := AC + (x1), Block X
0004: 01 0001 240          240 erg   ; Zelle 0004: (erg) := AC
0005: 01 0000 020          020 0     ; Zelle 0005: Halt
      20 0000 7540   blkX: equ 07540 ; vorher equ40 *    erste Anweisung: Gruppe 2
7540: 00 00000000005 x1:   dw  5     ; erste Zelle von Block X
7541: 20 7543              db  2     ; Rest: zusammen 3 Zellen
7543: 00 00000000011 l0001 dw  9     
