0017: 00000000004 # dw 4 ; 0, 1, 2, ...
0020: 00000000005 # dw 5 ; 0, 1, 2, ...
0021: 00000000006 # dw 6 ; 0, 1, 2, ...
0022: 00000000007 # dw 7 ; 0, 1, 2, ...
0023: 00000000010 # dw 8 ; 0, 1, 2, ...
0024: 00000000001 # dw 1 ; Block groesser als 8 Zellen
0025: 00000000002 # dw 2 ; 11-9 = 2
0026: 00000000020 # haupt: 020 0 ; Zelle 0026: Halt
0034: 00000000001 # dw 1 ; 1 Zelle
0035: 00000000002 # dw 2 ; 1 Zelle
0036: 00000000211 # 211 0 ; 1 Zelle
0037: 00000000240 # 240 0 ; 1 Zelle
0040: 00000000003 # tab_e: dw 3 ; hier endet Block A (diese Zeile zaehlt nicht mehr)
0041: 00000000000 # b_von: dbn 3 ; 3 Zellen
0042: 00000000000
0043: 00000000000
0044: 00000027000 # da tab_a ; 1 Zelle
0053: 00000000001 # dw 1 ; 1 Zelle
0054: 00000000000 # b_bis: dw 0 ; hier endet Block B
0055: 00000000000 # c_bis: dw 0 ; hier endet Block C
Tastenfolge:
H G R
Prüfungen:
BZ=0027 US=1
