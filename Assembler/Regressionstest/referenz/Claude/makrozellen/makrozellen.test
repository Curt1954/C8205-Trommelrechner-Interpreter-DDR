#DOK-0001 Test: PAAR liefert zellen(von,bis) und den echten Abstand bis-von; FOLGE erzeugt so viele Woerter wie der Block Zellen hat; SCHALTER, DREI
#PROT STUFE=2
0000: 00000026000 # 000 haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 00000000011 # dw 9 ; Zellenzahl des Blocks in Pass 0 (tab_a,tab_e werden eingeklammert eingesetzt)
0002: 00000000011 # dw tab_e-tab_a ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
0003: 00000000013 # dw 11 ; Zellenzahl des Blocks in Pass 0 (b_von,b_bis werden eingeklammert eingesetzt)
0004: 00000000013 # dw b_bis-b_von ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
0005: 00000000000 # dw 0 ; Zellenzahl des Blocks in Pass 0 (c_von,c_bis werden eingeklammert eingesetzt)
0006: 00000000000 # dw c_bis-c_von ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
0007: 00000000012 # dw 10 ; Zellenzahl des Blocks in Pass 0 (tab_a,b_von werden eingeklammert eingesetzt)
0010: 00000000012 # dw b_von-tab_a ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
0011: 00000000000 # dw 0 ; Zellenzahl des Blocks in Pass 0 (marke_allein,tab_e werden eingeklammert eingesetzt)
0012: 00000000000 # dw tab_e-marke_allein ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
0013: 00000000000 # dw 0 ; 0, 1, 2, ...
0014: 00000000001 # dw 1 ; 0, 1, 2, ...
0015: 00000000002 # dw 2 ; 0, 1, 2, ...
