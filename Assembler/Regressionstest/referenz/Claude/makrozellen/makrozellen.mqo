                     000                  haupt                ; Zelle 0000: Sprung zum Hauptprogramm
                     dw                   9                    ; Zellenzahl des Blocks in Pass 0 (tab_a,tab_e werden eingeklammert eingesetzt)
                     dw                   tab_e-tab_a          ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
                     dw                   11                   ; Zellenzahl des Blocks in Pass 0 (b_von,b_bis werden eingeklammert eingesetzt)
                     dw                   b_bis-b_von          ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
                     dw                   0                    ; Zellenzahl des Blocks in Pass 0 (c_von,c_bis werden eingeklammert eingesetzt)
                     dw                   c_bis-c_von          ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
                     dw                   10                   ; Zellenzahl des Blocks in Pass 0 (tab_a,b_von werden eingeklammert eingesetzt)
                     dw                   b_von-tab_a          ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
                     dw                   0                    ; Zellenzahl des Blocks in Pass 0 (marke_allein,tab_e werden eingeklammert eingesetzt)
                     dw                   tab_e-marke_allein   ; echter Abstand der beiden Marken nach Pass 2: muss gleich sein
                     dw                   0                    ; 0, 1, 2, ...
                     dw                   1                    ; 0, 1, 2, ...
                     dw                   2                    ; 0, 1, 2, ...
                     dw                   3                    ; 0, 1, 2, ...
                     dw                   4                    ; 0, 1, 2, ...
                     dw                   5                    ; 0, 1, 2, ...
                     dw                   6                    ; 0, 1, 2, ...
                     dw                   7                    ; 0, 1, 2, ...
                     dw                   8                    ; 0, 1, 2, ...
                     dw                   1                    ; Block groesser als 8 Zellen
                     dw                   2                    ; 11-9 = 2
haupt:               020                  0                    ; Zelle 0026: Halt
tab_a:               db                   5                    ; 5 Zellen
                     dw                   1                    ; 1 Zelle
                     dw                   2                    ; 1 Zelle
                     211                  0                    ; 1 Zelle
                     240                  0                    ; 1 Zelle
tab_e:               dw                   3                    ; hier endet Block A (diese Zeile zaehlt nicht mehr)
b_von:               dbn                  3                    ; 3 Zellen


                     da                   tab_a                ; 1 Zelle
                     db                   06                   ; 6 Zellen
                     dw                   1                    ; 1 Zelle
b_bis:               dw                   0                    ; hier endet Block B
c_bis:               dw                   0                    ; hier endet Block C
