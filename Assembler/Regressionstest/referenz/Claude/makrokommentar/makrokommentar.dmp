0003: 00 00000000014        dw  3*4   ; Produkt der beiden Parameter
0004: 00 00000000005        dw  5     ; erster Parameter
0005: 00 00000000006        dw  6     ; erster Parameter
0006: 00 00000000006        dw  1+2+3 ; Summe der drei Parameter
0007: 00 00000000025        dw  21    ; Wort 21 dezimal (025 oktal)
0010: 00 00000000036        dw  10+20 ; Summe der beiden Parameter
