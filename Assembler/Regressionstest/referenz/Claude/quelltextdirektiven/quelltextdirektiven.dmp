0012: 00 00000000002 w1:    dw  2     ; Zellen 0011 bis 0013: w0 = 1, w1 = 2, w2 = 3
0013: 00 00000000003 w2:    dw  3     ; Zellen 0011 bis 0013: w0 = 1, w1 = 2, w2 = 3
0014: 00 00000000001        dw  1     ; Zellen 0014 bis 0020: 1, 4, 9, 16, 25 dezimal
0015: 00 00000000004        dw  4     ; Zellen 0014 bis 0020: 1, 4, 9, 16, 25 dezimal
0016: 00 00000000011        dw  9     ; Zellen 0014 bis 0020: 1, 4, 9, 16, 25 dezimal
