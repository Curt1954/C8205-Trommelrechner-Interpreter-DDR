0037: 00 7773 211               211  ML0014GNU                  ; AC := Adresse des Wortes (R1 bleibt unveraendert)
0040: 00 0000 251               251  0                          ; R-Lesebefehl: AC := Wort (Adresse im AC)
0041: 01 0076 240               240  ML0004GNU                  ; rest := Wort (nie negativ, z0 bis z2 sind 0)
0042: 01 0156 330    ML0007GNU: 330  l0002                      ; Vergleich des Rests mit 0 (keine Operation), der AC bleibt der Rest
0043: 01 0064 170               170  ML0001GNU                  ; Rest 0: Wort fertig, Rueckkehr
0044: 01 7675 642               642  07675                      ; 15 mal Rechtsverschiebung (Operand nach Festlegung 026)
0045: 01 0157 200               200  l0003                      ; nur das Zeichen behalten
0046: 01 0077 240               240  ML0005GNU                  ; zeichen := Code mal 01000
0047: 01 0160 330               330  l0004                      ; Vergleich mit kat5 054 (Um. KB)
0050: 01 0065 170               170  ML0011GNU                  ; Um. KB: Zustand := KB
0051: 01 0161 330               330  l0005                      ; Vergleich mit kat5 055 (Um. GB)
0052: 01 0065 170               170  ML0011GNU                  ; Um. GB: Zustand := GB
0053: 01 0162 210    ML0008GNU: 210  l0006                      ; plus Adresse der Tabelle, Code 01 steht auf ML0013%
0054: 00 0000 251               251  0                          ; R-Lesebefehl: AC := fertiger Ausgabebefehl des Zeichens
0055: 01 0056 240               240  ML0009GNU                  ; Ausgabebefehl auf die naechste Zelle speichern
0056: 20 0057        ML0009GNU: db   1                          ; Laufzeit: Ausgabebefehl, wird sofort ausgefuehrt
0057: 01 0076 211               211  ML0004GNU                  ; AC := Zeichenrest
0060: 01 0163 200               200  l0007                      ; erstes Zeichen entfernen (die unteren 24 Bit bleiben)
0061: 01 7662 644               644  07662                      ; 6 mal Linksverschiebung (Operand nach Festlegung 026)
0062: 01 0076 240               240  ML0004GNU                  ; rest := Rest
0063: 01 0042 000               000  ML0007GNU                  ; naechstes Zeichen (der AC ist der Rest)
0064: 20 0065        ML0001GNU: db   1                          ; Laufzeit: Rueckkehrsprung, hier am Ende des UP sequentiell erreicht
0065: 00 7774 211    ML0011GNU: 211  ML0015GNU                  ; Um. KB / Um. GB: AC := R3 = Adresse der Zustandszelle (Adressfeld)
0066: 01 0164 210               210  l0008                      ; plus Operationscode 240: Speicherbefehl
0067: 01 0073 240               240  ML0012GNU                  ; Speicherbefehl auf die uebernaechste Zelle
0070: 01 0077 211               211  ML0005GNU                  ; AC := Code mal 01000 (054000 oder 055000)
0071: 01 0160 220               220  l0004                      ; AC := 0 (Um. KB) oder 01000 (Um. GB)
