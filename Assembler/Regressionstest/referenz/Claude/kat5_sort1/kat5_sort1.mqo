kat5_sort1:                  000                          *+3                          ; Zelle 0 des UP: Sprung ueber die zwei Parameter
ML0016DKR:                   db                           1                            ; Parameter 1: Anfangsadresse des Feldes (vom Aufrufer gefuellt)
ML0017DKR:                   db                           1                            ; Parameter 2: Fuelllaenge, Anzahl der Worte (vom Aufrufer gefuellt)
                             240                          ML0001DKR                    ; erste Codezelle: Rueckkehrwort sichern
                             211                          ML0017DKR                    ; AC := n
                             330                          l0001                        ; AC mit 1 vergleichen
                             140                          ML0001DKR                    ; n <= 1: nichts zu sortieren, Rueckkehr
                             240                          ML0002DKR                    ; zz := n (Zaehler)
                             211                          l0002                        ; AC := 0
                             240                          ML0003DKR                    ; sn := 0 (n in Adresseneinheiten, 01000 je Element)
ML0007DKR:                   211                          ML0003DKR                    ; AC := sn
                             210                          l0003                        ; AC := sn + 01000
                             240                          ML0003DKR                    ; sn := AC
                             211                          ML0002DKR                    ; AC := Zaehler
                             220                          l0001                        ; AC := Zaehler - 1
                             240                          ML0002DKR                    ; zz := AC
                             330                          l0002                        ; AC mit 0 vergleichen
                             170                          ML0008DKR                    ; Zaehler = 0: sn fertig, AC = 0, weiter
                             000                          ML0007DKR                    ; sonst naechste Adresseneinheit
ML0008DKR:                   240                          ML0004DKR                    ; i := 0 (AC = 0), spaeter i := i + 1
                             210                          l0003                        ; AC := i + 1
ML0009DKR:                   240                          ML0005DKR                    ; k := i + 1
                             210                          ML0016DKR                    ; AC := AC + Feldanfang
                             210                          l0004                        ; Befehl 240 a(k) bauen
                             240                          ML0014DKR                    ; Befehlszelle 1 := AC
                             251                          0                            ; AC := a(k)
                             240                          ML0006DKR                    ; H := a(k)
                             211                          ML0004DKR                    ; AC := i
                             210                          ML0016DKR                    ; AC := AC + Feldanfang
                             210                          l0004                        ; Befehl 240 a(i) bauen
                             240                          ML0015DKR                    ; Befehlszelle 2 := AC
                             251                          0                            ; AC := a(i)
                             330                          ML0006DKR                    ; AC mit H vergleichen
                             140                          ML0010DKR                    ; a(i) <= H: nicht tauschen
ML0014DKR:                   db                           1                            ; Laufzeit: 240 a(k): a(k) := a(i)
                             211                          ML0006DKR                    ; AC := alter Wert a(k)
ML0015DKR:                   db                           1                            ; Laufzeit: 240 a(i): a(i) := alter Wert a(k)
ML0010DKR:                   211                          ML0005DKR                    ; AC := k
                             210                          l0003                        ; AC := k + 1
                             330                          ML0003DKR                    ; AC mit sn vergleichen
                             170                          ML0011DKR                    ; k + 1 = n: innere Schleife fertig
                             000                          ML0009DKR                    ; weiter (AC = k + 1)
ML0011DKR:                   211                          ML0004DKR                    ; AC := i
                             210                          l0005                        ; AC := i + 2
                             330                          ML0003DKR                    ; AC mit sn vergleichen
                             170                          ML0001DKR                    ; i + 2 = n: Rueckkehr
                             220                          l0003                        ; AC := i + 1
                             000                          ML0008DKR                    ; weiter bei i := i + 1
ML0001DKR:                   db                           1                            ; Laufzeit: Rueckkehrsprung (Festlegung 010), hier am Ende des UP sequentiell erreicht
ML0002DKR:                   db                           1                            ; Arbeitszelle: Zaehler der Umrechnung
ML0003DKR:                   db                           1                            ; Arbeitszelle: n in Adresseneinheiten
ML0004DKR:                   db                           1                            ; Arbeitszelle: Index i (Adresseneinheiten)
ML0005DKR:                   db                           1                            ; Arbeitszelle: Index k (Adresseneinheiten)
ML0006DKR:                   db                           1                            ; Arbeitszelle: Hilfswert H
haupt:                       211                          l0006                        ; AC := Adresse des Feldes
                             240                          kat5_sort1+1                 ; Parameter 1 eintragen (Zelle Marke+1)
                             211                          l0007                        ; AC := 20 (Anzahl der Texte)
                             240                          kat5_sort1+2                 ; Parameter 2 eintragen (Zelle Marke+2)
                             025                          kat5_sort1                   ; Aufruf des Unterprogramms
                             211                          l0008                        ; AC := Adresse der KB/GB-Zelle des Schreibwerks
                             240                          r3                           ; R3 := Adresse der Zustandszelle (Festlegung 030)
                             030                          04500                        ; 4500 oder K2 oder LSL2 oder SW1 Output
                             211                          l0009                        ; AC := Adresse des Wortes Zeilenschaltung + Um. KB
                             240                          r1                           ; R1 := Adresse von init
                             025                          ausgabe                      ; neue Zeile und Um. KB drucken (das BIS laesst das Schreibwerk auf GB)
                             211                          l0006                        ; AC := Adresse des (sortierten) Feldes
                             240                          pa                           ; pa := Adresse des ersten Textes
                             211                          l0007                        ; AC := 20 (Anzahl der Texte)
                             240                          pz                           ; pz := Zaehler der noch zu druckenden Texte
pl:                          211                          pa                           ; AC := Adresse des aktuellen Textes
                             240                          r1                           ; R1 := Adresse des Textes
                             025                          ausgabe                      ; Text drucken (KAT5AUSGABE)
                             211                          l0010                        ; AC := Adresse des Wortes Zeilenschaltung
                             240                          r1                           ; R1 := Adresse von zeil
                             025                          ausgabe                      ; Zeilenschaltung drucken
                             211                          pa                           ; AC := Adresse des aktuellen Textes
                             210                          l0003                        ; AC := Adresse des naechsten Textes (eine Adresseinheit weiter)
                             240                          pa                           ; pa := Adresse des naechsten Textes
                             211                          pz                           ; AC := Zaehler
                             220                          l0001                        ; AC := Zaehler - 1
                             240                          pz                           ; pz := AC
                             330                          l0002                        ; AC mit 0 vergleichen
                             170                          halt                         ; Zaehler = 0: alle Texte gedruckt, Halt
                             000                          pl                           ; sonst naechster Text
halt:                        020                          0                            ; Halt: Feld ist sortiert und gedruckt
feld:                        kat5                         w                            ; Text[0] = w, Wort 04700000000
                             kat5                         8k                           ; Text[1] = 8k, Wort 01733000000
                             kat5                         6z                           ; Text[2] = 6z, Wort 01552000000
                             kat5                         r                            ; Text[3] = r, Wort 04200000000
                             kat5                         x                            ; Text[4] = x, Wort 05000000000
                             kat5                         1qy6                         ; Text[5] = 1qy6, Wort 01041511500
                             kat5                         kuva                         ; Text[6] = kuva, Wort 03345462100
                             kat5                         6                            ; Text[7] = 6, Wort 01500000000
                             kat5                         41                           ; Text[8] = 41, Wort 01310000000
                             kat5                         mvy                          ; Text[9] = mvy, Wort 03546510000
                             kat5                         nma                          ; Text[10] = nma, Wort 03635210000
                             kat5                         h                            ; Text[11] = h, Wort 03000000000
                             kat5                         ga                           ; Text[12] = ga, Wort 02721000000
                             kat5                         b5xb                         ; Text[13] = b5xb, Wort 02214502200
                             kat5                         fy                           ; Text[14] = fy, Wort 02651000000
                             kat5                         4wh                          ; Text[15] = 4wh, Wort 01347300000
                             kat5                         qk                           ; Text[16] = qk, Wort 04133000000
                             kat5                         m                            ; Text[17] = m, Wort 03500000000
                             kat5                         4u9                          ; Text[18] = 4u9, Wort 01345200000
                             kat5                         5g                           ; Text[19] = 5g, Wort 01427000000
zeil:                        kat5                         $wrzl                        ; Wort Zeilenschaltung (kat5 053), steht hinter dem Feld
init:                        kat5                         $wrzl$inkb                   ; Wort Zeilenschaltung und Um. KB (kat5 053, 054): Anfang des Drucks
kbaus:                       dw                           0                            ; KB/GB-Zustand des Schreibwerks (0 = KB, 1 = GB), anfangs KB (Festlegung 030)
pa:                          db                           01                           ; Arbeitszelle pa: Adresse des aktuellen Textes beim Drucken
pz:                          db                           01                           ; Arbeitszelle pz: Zaehler beim Drucken
ausgabe:                     240                          ML0001JQX                    ; Rueckkehrwort sichern
                             211                          ML0014JQX                    ; AC := Adresse des Wortes (R1 bleibt unveraendert)
                             251                          0                            ; R-Lesebefehl: AC := Wort (Adresse im AC)
                             240                          ML0004JQX                    ; rest := Wort (nie negativ, z0 bis z2 sind 0)
ML0007JQX:                   330                          l0002                        ; Vergleich des Rests mit 0 (keine Operation), der AC bleibt der Rest
                             170                          ML0001JQX                    ; Rest 0: Wort fertig, Rueckkehr
                             642                          07675                        ; 15 mal Rechtsverschiebung (Operand nach Festlegung 026)
                             200                          l0011                        ; nur das Zeichen behalten
                             240                          ML0005JQX                    ; zeichen := Code mal 01000
                             330                          l0012                        ; Vergleich mit kat5 054 (Um. KB)
                             170                          ML0011JQX                    ; Um. KB: Zustand := KB
                             330                          l0013                        ; Vergleich mit kat5 055 (Um. GB)
                             170                          ML0011JQX                    ; Um. GB: Zustand := GB
ML0008JQX:                   210                          l0014                        ; plus Adresse der Tabelle, Code 01 steht auf ML0013%
                             251                          0                            ; R-Lesebefehl: AC := fertiger Ausgabebefehl des Zeichens
                             240                          ML0009JQX                    ; Ausgabebefehl auf die naechste Zelle speichern
ML0009JQX:                   db                           1                            ; Laufzeit: Ausgabebefehl, wird sofort ausgefuehrt
                             211                          ML0004JQX                    ; AC := Zeichenrest
                             200                          l0015                        ; erstes Zeichen entfernen (die unteren 24 Bit bleiben)
                             644                          07662                        ; 6 mal Linksverschiebung (Operand nach Festlegung 026)
                             240                          ML0004JQX                    ; rest := Rest
                             000                          ML0007JQX                    ; naechstes Zeichen (der AC ist der Rest)
ML0001JQX:                   db                           1                            ; Laufzeit: Rueckkehrsprung, hier am Ende des UP sequentiell erreicht
ML0011JQX:                   211                          ML0015JQX                    ; Um. KB / Um. GB: AC := R3 = Adresse der Zustandszelle (Adressfeld)
                             210                          l0004                        ; plus Operationscode 240: Speicherbefehl
                             240                          ML0012JQX                    ; Speicherbefehl auf die uebernaechste Zelle
                             211                          ML0005JQX                    ; AC := Code mal 01000 (054000 oder 055000)
                             220                          l0012                        ; AC := 0 (Um. KB) oder 01000 (Um. GB)
                             642                          07653                        ; 9 mal Rechtsverschiebung (Operand nach Festlegung 026)
ML0012JQX:                   db                           1                            ; Laufzeit: 240 <Zustandszelle>, speichert den Zustand
                             211                          ML0005JQX                    ; AC := Code mal 01000, zurueck zur Ausgabe des Zeichens
                             000                          ML0008JQX                    ; Zeichen ausgeben
ML0004JQX:                   db                           1                            ; Arbeitszelle: noch auszugebender Zeichenrest
ML0005JQX:                   db                           1                            ; Arbeitszelle: aktueller kat5-Code mal 01000
ML0013JQX:                   dto                          \ \                          ; Tabelle, Code 01: Leerzeichen
