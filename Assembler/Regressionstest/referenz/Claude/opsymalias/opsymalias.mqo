        000     haupt   ; Zelle 0000: Sprung zum Hauptprogramm
a:      dw      5       ; Zelle 0001: Konstante 5
b:      dw      3       ; Zelle 0002: Konstante 3
erg:    dw      0       ; Zelle 0003: Ergebnis
haupt:  211     a       ; Zelle 0004: AC := 5
        211     a       ; Zelle 0005: AC := 5 (Laden mit Loeschen, keine Addition)
        211     b       ; Zelle 0006: AC := 3
        240     erg     ; Zelle 0007: erg := 3
        020     0       ; Zelle 0010: Halt
