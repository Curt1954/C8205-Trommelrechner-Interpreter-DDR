0011: 00000000012 # dw 10 ; grosses B, 5*2 = 10 = 012
0012: 00004000000 # dw 1048576 ; 2^20 = 04000000
0013: 00000000015 # dw 13 ; 5 ODER 010 (oktal 8) = 13 = 015
0014: 00000000010 # dwb 1000 ; 3+5 = 8 = 1000 binaer = 010
0015: 00000000005 # dw 5 ; fuehrende Nullen zaehlen nicht: 5
0016: 00000000137 # dw 95 ; -5 + 100 = 95 = 0137
