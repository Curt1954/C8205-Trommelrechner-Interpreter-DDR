0026: 00000000013 # dw 11 ; 11 Zeichen = 013
0027: 00000002322 # dw 1234 ; 1234 = 02322
0030: 00000000020 # dw 16 ; 16 Zeichen = 020
0031: 00000002322 # dw 1234 ; 1234 = 02322
0032: 00000000312 # dw 202 ; 101 Werte, je zwei Pruefungen: 202 = 0312
0033: 00000000077 # dw 63 ; 63 Zeichen = 077
0034: 00000000000 # dw 0 ; gleiche Zahl zurueck: Unterschied 0
0035: 00000001164 # haupt: 164 0001 ; Zelle 29: Diagnoseausgabe (nur im Test)
0036: 00000000020 # 020 0 ; Zelle 30: Halt
