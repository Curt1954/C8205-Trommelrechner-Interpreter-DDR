0021: 00000000137 # dw 95 ; -5 + 100 = 95 = 0137
0022: 00000000000 # dw 0 ; 0
0023: 00000000001 # dw 1 ; 1
0024: 00000000777 # dw 511 ; 63 Einsen = 2^63-1, durch 2^54 geteilt = 511 = 0777
