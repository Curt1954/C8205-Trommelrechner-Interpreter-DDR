#DOK-0001 Test $CALCB und $CALCBn (Ausgabe), 0b-Zahl im Ausdruck (Eingabe), $VALB (Text nach Zahl), Rundreise, $VAL unveraendert
#PROT STUFE=2
0000: 00000035000 # 000 haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 00000000012 # dwb 1010 ; 10 = 1010 binaer = 012 oktal
0002: 00000000000 # dwb 0 ; 0 ergibt die Ziffer 0
0003: 00000000005 # dwb 00000101 ; mit Breite 8: 00000101 = 5
0004: 00000000005 # dwb 000000000000000000000000000000101 ; Breite 33 (ein ganzes Wort) = 5
0005: 77777777777 # dwb 111111111111111111111111111111111 ; 2^33-1: 33 Einsen = 77777777777 oktal
