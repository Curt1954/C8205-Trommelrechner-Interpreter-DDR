0000: 00 4500 030    haupt: 030 04500        ; Schreibwerk SW1 als Ausgabe anwaehlen
      00 1170 030           dz  $inkb        ; Zeichenlage Kleinbuchstaben (beim Start zufaellig)
0002: 01 0017 211           211 k_adr        ; AC := Wort fuer den Adressdruck
0003: 00 7773 240           240 adr7773      ; Uebergabe in R1
0004: 00 0220 025           025 adressdruck  ; Adressdruck
      00 2720 030           dz  $wrzl        ; Zeilenschaltung
0006: 01 0020 211           211 k_bef        ; AC := Wort fuer den Befehlsdruck
0007: 00 7773 240           240 adr7773      
0010: 00 0240 025           025 befehlsdruck ; Befehlsdruck
      00 2720 030           dz  $wrzl        
0012: 01 0021 211           211 k_tri        ; AC := Wort fuer den Triadendruck
0013: 00 7773 240           240 adr7773      
0014: 00 0200 025           025 triadendruck ; Triadendruck
      00 2720 030           dz  $wrzl        
0016: 01 0000 020           020 0            ; unbedingter Stopp
0017: 00 01234567012 k_adr: dw  01234567012  ; Adressdruck: Ziffern 5 bis 8 = 4567
0020: 00 03210765432 k_bef: dw  03210765432  ; Befehlsdruck: Ziffern 5 bis 11 = 0765 432
0021: 00 07654321065 k_tri: dw  07654321065  ; Triadendruck: alle Ziffern = 0765 4321 065
