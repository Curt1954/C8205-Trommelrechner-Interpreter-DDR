Trommeldatei:
#DOK-0001 Addition mit Zahlenbereichsueberschreitung (Programmieranleitung 5.10), a=1 b=2 c=3, Summe 6 ohne Ueberlauf
#SPEI-0001 3000-3003
#PROT STUFE=2
0000: 00003005000 # m0000: 000 m3005 ; Sprung zum Programmanfang
3000: 00000000001 # d3000: dw 01 ; a
3001: 00000000002 # d3001: dw 02 ; b
3002: 00000000003 # d3002: dw 03 ; c
3003: 00000000000 # m3003: 000 m0000 ; Ergebniszelle (a+b+c bzw. 4000 0000 000 bei Ueberlauf)
3004: 40000000000 # d3004: dw 040000000000 ; Konstante 4000 0000 000
3005: 00003000211 # m3005: 211 d3000 ; <AC>:=a
3006: 00003001210 # 210 d3001 ; <AC>:=a+b
3007: 00003013070 # 070 m3013 ; Ueberlaufsprung
3010: 00003002210 # 210 d3002 ; <AC>:=a+b+c
3011: 00003013070 # 070 m3013 ; Ueberlaufsprung
3012: 00003014000 # 000 m3014 ; Sprung zum Speichern
3013: 00003004211 # m3013: 211 d3004 ; <AC>:=4000 0000 000
3014: 00003003240 # m3014: 240 m3003 ; <3003>:=<AC>
3015: 00000001164 # 164 00001 ; DEBUG Nr. 0001
3016: 00000000020 # 020 0 ; unbedingter Stop
Tastenfolge:
H G R
