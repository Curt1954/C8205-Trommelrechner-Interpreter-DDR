#DOK-0001 Zahlwort Festkomma vorn: Division positiver Zahlen (Programmieranleitung 6.1.4), Zahlenbeispiel des Buches a=0,010000 b=0,100000
#DOK-0001 Programm wie im Buch ab Zelle 3000; a=<3010>, b=<3011>, Maske <3012>=7777 7777 777, Arbeitsspur 7700; 7700 440 Transport von b/2
#DOK-0001 Voraussetzung 0 <= a < b < 1; <AC> = 0 beim Start (3000 212 rechnet <AC>:=<AC>+b mit Rechtsverschiebung). Die Quotientenziffern
#DOK-0001 erwartet <AC> = 57777777777 (oktal), Fehler gegenueber a/b kleiner als 2^-26
#PROT STUFE=2
0000: 00003000000 # 000 m3000 ; Sprung zum Programmanfang der Aufgabe (Programm beginnt in Zelle 3000)
3000: 00003011212 # m3000: 212 d3011 ; 3011 212 ; <AC>:=2^-1*b
3001: 00007700440 # 440 d7700 ; 7700 440 ; Transport von 2^-1*b auf alle Zellen der Arbeitsspur
3002: 00003012211 # 211 d3012 ; 3012 211 ; <AC>:=7777 7777 777
3003: 00007700454 # 454 d7700 ; 7700 454 ; niedrige Bits von b in den Zellen der Arbeitsspur loeschen
3004: 00003010221 # 221 d3010 ; 3010 221 ; <AC>:=-a
3005: 00003011210 # 210 d3011 ; 3011 210 ; <AC>:=b-a
3006: 00007700436 # 436 d7700 ; 7700 436 ; <AC>:=+-q (Divisionsvorgang)
3007: 00003000020 # 020 03000 ; 3000 020 ; unbedingter Stopp
3010: 10000000000 # d3010: dw 010000000000 ; a
3011: 20000000000 # d3011: dw 020000000000 ; b
3012: 37777777777 # d3012: dw 037777777777 ; Maske zum Abschneiden der niedrigsten Bits von b
