#DOK-0001 Oktaldruck (Programmieranleitung 5.17, Abb. 26): Inhalt der Zelle 7777 in Triadenschreibweise drucken, <7777> = 70123456701
--sw-ausgabe Test-virtuelleGeraete/SW-Ausgabe
#SPEI-0001 3020-3020
#SPEI-0001 7777-7777
#PROT STUFE=2
0000: 00003100000 # 000 m3100 ; Sprung zum Startstück
3100: 00004500030 # m3100: 030 04500 ; Anwahl Kanal K2 (Schreibwerk-Ausgabe)
3101: 00001170030 # 030 01170 ; Umschaltung auf KB
3102: 00003000000 # 000 m3000 ; Sprung zum Programmanfang
7777: 70123456701 # d7777: dw 070123456701 ; Zelle a = 7777, Testwert
