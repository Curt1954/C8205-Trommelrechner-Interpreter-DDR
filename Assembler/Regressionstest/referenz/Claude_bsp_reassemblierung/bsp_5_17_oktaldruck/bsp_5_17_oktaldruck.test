3004: 00003015006 # 006 m3015 ; <AC>:=Vzl2(a), 2. Teil
3005: 00000010030 # 030 00010 ; Druck "1"
3006: 00000260030 # 030 00260 ; Druck "6"
3007: 00007721520 # m3007: 520 d7721 ; GX-Subtraktion zur Bestimmung der zu druckenden Oktalziffer
3010: 77740000000 # d3010: dw 077740000000 ; Konstante
3011: 00003020311 # 311 d3020 ; <AC>:=z; Vergleicher 3, falls z=0
3012: 00003036170 # 170 m3036 ; Prüfen, ob z=0
3013: 00003034004 # 004 m3034 ; z:=Vl(z) (im Listing als "z:=z+1" gedruckt, Ablaufplan: z:=Vl(z))
3014: 00000040030 # 030 00040 ; Druck "4"
3015: 00003024006 # m3015: 006 m3024
3017: 00000000007 # d3017: dw 07 ; Konstante zum Ausblenden der letzten Triade
3022: 00000020030 # 030 00020 ; Druck "2"
3023: 00000070030 # 030 00070 ; Druck "7"
3024: 00007777240 # m3024: 240 d7777 ; a:=Vzl3(a)
3025: 00003017200 # 200 d3017 ; <AC>:=t
3026: 00003007000 # 000 m3007
3027: 00000000001 # d3027: dw 01 ; Konstante
3030: 00000200030 # 030 00200 ; Druck "0"
3031: 00000250030 # 030 00250 ; Druck "5"
3032: 00007724440 # m3032: 440 d7724
3033: 00003010211 # 211 d3010 ; <AC>:=7774 0000 000
