#DOK-0001 Programm wie im Buch ab Zelle 3000; a=<3007>, b=<3010>, Arbeitsspur 7700; das Ergebnis weicht durch die Rundung um weniger als
#DOK-0001 erwartet <AC> = a*b = 25761027732 (oktal), Teilprodukte b(i)*a in den 32 Zellen der Arbeitsspur 7700
#PROT STUFE=2
0000: 00003000000 # 000 m3000 ; Sprung zum Programmanfang der Aufgabe (Programm beginnt in Zelle 3000)
3000: 00003007211 # m3000: 211 d3007 ; 3007 211 ; <AC>:=a
3001: 00007700440 # 440 d7700 ; 7700 440 ; Transport von a auf alle Zellen einer Spur
3002: 00003010211 # 211 d3010 ; 3010 211 ; <AC>:=b
