3004: 00003011211 # 211 d3011 ; 3011 211 ; <AC>:=2^-1 (Rundung des Resultats)
3005: 00007700412 # 412 d7700 ; 7700 412 ; <AC>:=a*b, Summierung der Teilprodukte
3006: 00003000020 # 020 03000 ; 3000 020 ; unbedingter Stopp
