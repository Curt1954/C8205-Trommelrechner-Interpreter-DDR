#DOK-0001 Ganze Festkommazahlen: Multiplikation positiver ganzer Zahlen (Programmieranleitung 6.2.1), Zahlenbeispiel des Buches b=101,
#DOK-0001 Programm wie im Buch ab Zelle 3000; a=<3006>, b=<3007>, Arbeitsspur 7700; 7700 444 Transport von a, je Zelle um ein Bit nach
#DOK-0001 erwartet <AC> = a*b = 11*5 = 55 (dezimal) = 00000000067 (oktal), das Produkt liegt im Zahlenbereich
#PROT STUFE=2
0000: 00003000000 # 000 m3000 ; Sprung zum Programmanfang der Aufgabe (Programm beginnt in Zelle 3000)
3000: 00003006211 # m3000: 211 d3006 ; 3006 211 ; <AC>:=a
3001: 00007700444 # 444 d7700 ; 7700 444 ; Transport von a, jeweils um ein Bit nach links verschoben, auf alle Zellen der
3002: 00003007211 # 211 d3007 ; 3007 211 ; <AC>:=b
3003: 00007700472 # 472 d7700 ; 7700 472 ; Bildung der Teilprodukte P(i)=b(32-i)*a(i)
3004: 00007700410 # 410 d7700 ; 7700 410 ; <AC>:=a*b, Summierung der Teilprodukte
3005: 00003000020 # 020 03000 ; 3000 020 ; unbedingter Stopp
3006: 00000000013 # d3006: dw 013 ; a
3007: 00000000005 # d3007: dw 05 ; b
