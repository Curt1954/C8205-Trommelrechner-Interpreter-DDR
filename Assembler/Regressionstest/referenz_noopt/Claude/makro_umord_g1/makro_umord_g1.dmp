0000: 01 0001 000           000    haupt        ; Zelle 0000: Sprung zum Hauptprogramm
0001: 01 0000 020    haupt: 020    0            ; Zelle 0001: Halt (das UP wird nicht aufgerufen, nur erzeugt)
0002: 01 3000        am:    da     000000000003 ; Zelle 0002: Adresse der Marke am Aufruf (Wert der Marke mal 01000)
      20 0000 0003   g1:    equ    00003        ; automatisch generiert
      20 0000 0100          equ100 00100        ; erste Anweisung: auf die naechste 0100-Grenze (Gruppe 1)
0100: 00 00000000701        dw     0701         ; Rumpfzelle 1
0101: 00 00000000702        dw     0702         ; Rumpfzelle 2
0102: 00 00000000703        dw     0703         ; Rumpfzelle 3
0103: 00 00000000704        dw     0704         ; Rumpfzelle 4
0104: 00 00000000705        dw     0705         ; Rumpfzelle 5
0105: 00 00000000706        dw     0706         ; Rumpfzelle 6
