0005: 00000110210 # 210 c1 ; Zelle 0005: AC := AC + (c1), Block C
0006: 00000112210 # 210 d1 ; Zelle 0006: AC := AC + (d1), Block D
0007: 00000001240 # 240 erg ; Zelle 0007: (erg) := AC
0010: 00000000020 # 020 0 ; Zelle 0010: Halt
0100: 00000000001 # a1: dw 1 ; erste Zelle von Block A
0103: 00000000002 # b1: dw 2 ; erste Zelle von Block B
0110: 00000000004 # c1: dw 4 ; erste Zelle von Block C
0112: 00000000010 # d1: dw 8 ; erste Zelle von Block D
