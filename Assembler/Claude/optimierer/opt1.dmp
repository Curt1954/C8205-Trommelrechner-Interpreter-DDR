0000: 01 0001 000          000   haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 01 0006 211    haupt 211   l0001 ; Zelle 0001: AC := 5 (Literal l0001, wandert nach 0006)
0002: 01 0007 210          210   l0002 ; Zelle 0002: AC := AC + 7 (Literal l0002, wandert nach 0007)
0003: 01 0010 240          240   erg   ; Zelle 0003: (erg) := AC
0004: 01 0001 164          164   0001  ; Zelle 0004: Diagnoseausgabe (nur im Test)
0005: 01 0000 020          020   0     ; Zelle 0005: Halt
0006: 00 00000000005 l0001 dw    5     
0007: 00 00000000007 l0002 dw    7     
0010: 0              erg:  dw    0     ; ohne Optimierer Zelle 0041; mit Optimierer Zelle 0010 (erg wird nur als Adressteil benutzt)
      20 0000 0040         equ40 00040 ; Zaehler springt von 0006 auf 0040, Sprungbereich 0006 bis 0037 ist frei
0040: 00 00000000003       dw    3     ; Zelle 0040: Fueller ohne Marke, nie verlegbar (dw unmittelbar hinter equ40)
