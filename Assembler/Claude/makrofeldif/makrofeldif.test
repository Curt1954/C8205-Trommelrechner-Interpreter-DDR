Trommeldatei:
#DOK-0001 Feldzugriffe in den Bedingungen von $IF und $ELIF, auch mit $CALC
#PROT STUFE=2
#TROMMEL=LEER
0000: 00000004000 # 000 haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 00000000001 # dw 1 ; 5 < 9 gilt
0002: 00000000004 # dw 4 ; 9 - 5 = 4 gilt
0003: 00000000005 # dw 5 ; Elementzahl 3
0004: 00000001164 # haupt: 164 0001 ; Zelle 0004: Diagnoseausgabe (nur im Test)
0005: 00000000020 # 020 0 ; Zelle 0005: Halt
Tastenfolge:
H G R
Prüfungen:
BZ=0006 US=1
0001: 00000000001   # 5 < 9
0002: 00000000004   # 9 - 5 = 4
0003: 00000000005   # Elementzahl 3
