Trommeldatei:
#TROMMEL=LEER
#DOK-0001 Makro der Gruppe 1 mitten im Programm wird hinter end verlegt (Umordnung uebernommen, Endadresse 0106 statt 0112)
0000: 00000001000 # 000 haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 00000000020 # haupt: 020 0 ; Zelle 0001: Halt (das UP wird nicht aufgerufen, nur erzeugt)
0002: 00000007000 # am: da 000000000007 ; Zelle 0002: Adresse der Marke am Aufruf (Wert der Marke mal 01000)
0003: 00000000111 # t1: dw 0111 ; Programmrest, Zelle 1
0004: 00000000222 # t2: dw 0222 ; Programmrest, Zelle 2
0005: 00000000333 # t3: dw 0333 ; Programmrest, Zelle 3
0006: 00000000444 # t4: dw 0444 ; Programmrest, Zelle 4
0100: 00000000701 # dw 0701 ; Rumpfzelle 1
0101: 00000000702 # dw 0702 ; Rumpfzelle 2
0102: 00000000703 # dw 0703 ; Rumpfzelle 3
0103: 00000000704 # dw 0704 ; Rumpfzelle 4
0104: 00000000705 # dw 0705 ; Rumpfzelle 5
0105: 00000000706 # dw 0706 ; Rumpfzelle 6
Tastenfolge:
H G R
Prüfungen:
