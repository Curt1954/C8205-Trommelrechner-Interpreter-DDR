Trommeldatei:
#TROMMEL=LEER
#DOK-0001 Makro im Makro: der innere Rumpf wandert mit dem aeusseren Block (Endadresse 0110 statt 0112)
0000: 00000001000 # 000 haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 00000000020 # haupt: 020 0 ; Zelle 0001: Halt (die UP werden nicht aufgerufen, nur erzeugt)
0002: 00000005000 # kopf: da 000000000005 ; Zelle 0002: Adresse der Marke am Aufruf von OUTER (Wert der Marke mal 01000)
0003: 00000000111 # t1: dw 0111 ; Programmrest, Zelle 1
0004: 00000000222 # t2: dw 0222 ; Programmrest, Zelle 2
0100: 00000000701 # dw 0701 ; erste Rumpfzelle (Marke fuer den Test)
0101: 00000000711 # dw 0711 ; erste Rumpfzelle (Marke fuer den Test)
0106: 00000000712 # dw 0712 ; letzte Rumpfzelle (Marke fuer den Test)
0107: 00000000702 # dw 0702 ; letzte Rumpfzelle (Marke fuer den Test)
Tastenfolge:
H G R
Prüfungen:
BZ=0002
0002: 00000005000   # kopf: da outer, outer = 0005 (Zaehler vor dem Aufrunden am neuen Platz)
0003: 00000000111   # t1: Programmrest rueckt auf 0003
0004: 00000000222   # t2
0100: 00000000701   # OUTER, erste Zelle
0101: 00000000711   # INNER, erste Zelle (im Block von OUTER)
0106: 00000000712   # INNER, letzte Zelle
0107: 00000000702   # OUTER, letzte Zelle
0110: 00000000000   # hinter dem Block steht nichts (Endadresse 0110)
0111: 00000000000   # (im Original stuende hier t2)
