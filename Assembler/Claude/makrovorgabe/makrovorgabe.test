0005: 00000000077   # $REPT $# = 1 Wort
0006: 00000000002   # Anzahl: 2
0007: 00000000006   # $2 uebergeben = 6
0010: 00000000000   # Vorgabe $3 = 0
0011: 00000000014   # 10+2 = 12 = 014
