0004: 00000000000 # zb: dw 0 ; Zelle 0004: Zaehler Fall B (bleibt 0)
0005: 00000000000 # zc: dw 0 ; Zelle 0005: Zaehler Fall C (soll 1 werden)
0006: 00000000000 # zd: dw 0 ; Zelle 0006: Zaehler Fall D (bleibt 0)
0007: 00000000000 # ze: dw 0 ; Zelle 0007: Fall E (bleibt 0)
0010: 00000000001 # eins: dw 1 ; Zelle 0010: Konstante 1
0011: 00000001211 # haupt: 211 wert ; Zelle 0011: Akkumulator laden (017)
0012: 00000002240 # 240 merk ; Akkumulator sichern
0013: 00000003211 # 211 zaehler ; Zaehler laden
0014: 00000010210 # 210 eins ; um 1 erhoehen
0015: 00000003240 # 240 zaehler ; Zaehler zurueckspeichern
0016: 00000002211 # 211 merk ; Akkumulator wiederherstellen
0017: 00000002240 # 240 merk ; Akkumulator sichern
0020: 00000005211 # 211 zc ; Zaehler laden
0021: 00000010210 # 210 eins ; um 1 erhoehen
0022: 00000005240 # 240 zc ; Zaehler zurueckspeichern
0023: 00000002211 # 211 merk ; Akkumulator wiederherstellen
0024: 00000001164 # 164 0001 ; Zelle 0024: Diagnoseausgabe (nur im Test)
0025: 00000000020 # 020 0 ; Zelle 0025: Halt
