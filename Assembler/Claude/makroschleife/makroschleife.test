0052: 00000046211 # haupt: 211 eins ; AC := 1
0053: 00000046210 # 210 eins ; AC := AC + 1 (Durchlauf 0)
0054: 00000046210 # 210 eins ; AC := AC + 1 (Durchlauf 1)
0055: 00000046210 # 210 eins ; AC := AC + 1 (Durchlauf 2)
0056: 00000047240 # 240 erg1 ; Ergebnis ablegen
0057: 00000044211 # 211 w1 ; AC := 8 (Label aus der Schleife)
0060: 00000045210 # 210 w2 ; AC := 8 + 9 = 17
0061: 00000050240 # 240 erg2 ; Ergebnis ablegen
0062: 00000046211 # 211 eins ; AC := 1
0063: 00000064000 # 000 ML0001LSZ_0 ; Sprung zur naechsten Zelle (Durchlauf 0)
0064: 00000046210 # ML0001LSZ_0: 210 eins ; AC := AC + 1
0065: 00000066000 # 000 ML0001LSZ_1 ; Sprung zur naechsten Zelle (Durchlauf 1)
