Trommeldatei:
#DOK-0001 Test der Makro-Schleife und der geschachtelten Bedingungen: Zaehler $Z1/$Z2, Schleifen im $IF, $IF im $IF, $ELSE, Klammern, bis zu acht Bedingungsbloecke
#PROT STUFE=2
#TROMMEL=LEER
0000: 00000052000 # 000 haupt ; Zelle 0000: Sprung zum Hauptprogramm
0001: 00000000000 # dw 0 ; Wort 0: Zaehler mal Schrittweite
