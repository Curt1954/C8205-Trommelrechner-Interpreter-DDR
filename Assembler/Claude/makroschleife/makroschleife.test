0036: 00000000000 # dw 0 ; Bedingung nicht erfuellt
0037: 00000000001 # dw 1 ; Wert 1 bis 6
0040: 00000000000 # dw 0 ; anderer Wert
0041: 00000000000 # dw 0 ; gleich null
0042: 00000000001 # dw 1 ; ungleich null
0043: 00000000007 # w0: dw 7 ; Label w0 mit dem Wert 7 plus Zaehler
0044: 00000000010 # w1: dw 8 ; Label w1 mit dem Wert 7 plus Zaehler
0045: 00000000011 # w2: dw 9 ; Label w2 mit dem Wert 7 plus Zaehler
0046: 00000000001 # eins: dw 1 ; Zelle 0046: Konstante 1
