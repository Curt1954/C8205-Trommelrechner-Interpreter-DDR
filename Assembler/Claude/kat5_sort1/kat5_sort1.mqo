                             dz                           $wrzl                        ; Code 053: Zeilenschaltung (Satzmarke)
                             dz                           $inkb                        ; Code 054: Um. KB
                             dz                           $ingb                        ; Code 055: Um. GB
l0001                        dw                           000000000001                 
l0002                        dw                           000000000000                 
l0003                        dw                           000000001000                 
l0004                        dw                           000000000240                 
l0005                        dw                           000000002000                 
