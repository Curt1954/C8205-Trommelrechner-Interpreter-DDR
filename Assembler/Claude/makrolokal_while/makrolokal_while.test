0002: 00000000012 # dw 10 ; 10 + (1 - 1)
0003: 00000000001 # dw 1 ; 1
0004: 00000001164 # haupt: 164 0001 ; Zelle 0004: Diagnoseausgabe (nur im Test)
0005: 00000000020 # 020 0 ; Zelle 0005: Halt
