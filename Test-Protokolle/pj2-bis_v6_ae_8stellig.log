  #DOK-0001 BIS v6 ae_8stellig: Eingabe 1 2 3 4 5 6 7 0 . : acht Ziffern, Adressdruck zeigt 5670
  #TROMMEL=LEER (Trommel vor dem Test geleert: alle 4096 Zellen = 0; danach die Zeilen von Trommeldatei:)
  #PROT STUFE=2
  #STARTE 1000 (Makro: H G M+ 512x E M- R, E 512-mal = dezimal)
Tastenfolge: (aus #STARTE erzeugt)
  H  : Schalter H-R -> "H", Flag H := 1
  G  : alle Flags ausser H,T,BS,SP := 0 (BS, SP: eingerastete Schalter); BR := 0000 000 (AR:=0000, OR:=000); US := 1; K0 angewaehlt, SW nicht gedrueckt -> T := 1; BZ bleibt unveraendert (BZ := 0 erst bei Ausfuehrung des Sprungs nach 0000)
  M gedrueckt halten: OR := OR ODER 025 (BR = AR 025)
  E  : (M gehalten) Befehlsentnahme gesperrt, BZ := 0001, AR := 0001, AC := 00000002000 (BZ+1 im Adressfeld); BR-Adressteil := AR
  E  : (M gehalten) Befehlsentnahme gesperrt, BZ := 0002, AR := 0002, AC := 00000003000 (BZ+1 im Adressfeld); BR-Adressteil := AR
  ... 509 weitere E (BZ 0003 bis 0777): je Anschlag BZ := BZ+1, AR := BZ, AC := BZ+1 im Adressfeld (kompakte Protokollform bei #STARTE)
  E  : (M gehalten) Befehlsentnahme gesperrt, BZ := 1000, AR := 1000, AC := 00001001000 (BZ+1 im Adressfeld); BR-Adressteil := AR
  M loslassen: OR-Verknuepfung mit 025 entfaellt fuer Folgeschritte
  R  : Schalter H-R -> "R", Flag H := 0, US := 0; Interpretation beginnt bei Konnektor B
  Nicht spezifizierte Register (AC, ...) starten mit 0.

