  #DOK-0003 Prüfung der Sprung-Umstellung aller Zeichen des R 300-Codes (Streifen r300_alle_zeichen.txt, "/" am Ende), Leser 2
  #PROT STUFE=2
Tastenfolge: H G R
  H  : Schalter H-R -> "H", Flag H := 1
  G  : alle Flags ausser H,T,BS,SP := 0 (BS, SP: eingerastete Schalter); BR := 0000 000 (AR:=0000, OR:=000); US := 1; K0 angewaehlt, SW nicht gedrueckt -> T := 1; <BZ> := 0 (vorweggenommene Wirkung des Sprungs nach 0000)
  R  : Schalter H-R -> "R", Flag H := 0, US := 0; Interpretation beginnt bei Konnektor B
  Nicht spezifizierte Register (AC, ...) starten mit 0.

