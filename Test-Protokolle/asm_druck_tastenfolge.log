  #DOK-0001 Druck von BZ und AC (Bedienpult 4.2, 4.3): Ein bei 5000 laufendes Programm wird unterbrochen (BZ = 5000, AC = 10101010101).
  #DOK-0002 H G Ue E rettet den AC nach 7777 (BZ = 5001); H G M+ E M- R springt nach Zelle 0001 (druck) mit AC = 5003 im Adressfeld. Erwartet: BZ 00005000000 AC 10101010101, danach Fortsetzung ab 5000 mit dem AC.
  #DOK-0003 5000: Ausgabe eines Zeichens (030 0520), 5001: Stopp 1111. Der Stopp in 5001 zeigt, dass ab 5000 fortgesetzt wurde.
  #AC=10101010101
  #BZ=5000
  #PROT STUFE=2
Tastenfolge: H G Ü E H G M+ E M- R
  H  : Schalter H-R -> "H", Flag H := 1
  G  : alle Flags ausser H,T,BS,SP := 0 (BS, SP: eingerastete Schalter); BR := 0000 000 (AR:=0000, OR:=000); US := 1; K0 angewaehlt, SW nicht gedrueckt -> T := 1; BZ bleibt unveraendert (BZ := 0 erst bei Ausfuehrung des Sprungs nach 0000)
  Ue : AR := 7777; OR := OR ODER 240 -> BR = 7777 240 (Transport, aufgestellt, nicht ausgefuehrt)
  E  : Einzelschritt (Phase IV, I, II, III), Halt vor Knoten 019; BR=0520 030 BZ=5001 AR=0520 AC=10101010101
  H  : Schalter H-R -> "H", Flag H := 1
  G  : alle Flags ausser H,T,BS,SP := 0 (BS, SP: eingerastete Schalter); BR := 0000 000 (AR:=0000, OR:=000); US := 1; K0 angewaehlt, SW nicht gedrueckt -> T := 1; BZ bleibt unveraendert (BZ := 0 erst bei Ausfuehrung des Sprungs nach 0000)
  M gedrueckt halten: OR := OR ODER 025 (BR = AR 025)
  E  : (M gehalten) Befehlsentnahme gesperrt, BZ := 0001, AR := 0001, AC := 00005003000 (BZ+1 im Adressfeld)
  M loslassen: OR-Verknuepfung mit 025 entfaellt fuer Folgeschritte
  R  : Schalter H-R -> "R", Flag H := 0, US := 0; Interpretation beginnt bei Konnektor B
  Anfangswerte: AC = 10101010101 (#AC), BZ = 5000 (#BZ)
  Nicht spezifizierte Register (AR, OR, ...) starten mit 0.

